# ─── API ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Orígenes extra permitidos por CORS (coma-separados) durante una migración de dominio
# CORS_EXTRA_ORIGINS=
# Host público que recibe el webhook de Mercado Pago (por defecto cae a WEB_ORIGIN)
# WEBHOOK_PUBLIC_URL=

# Postgres (Supabase Session Pooler recomendado)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cookie/session signing (cambiar en prod)
COOKIE_SECRET=change-me-in-prod-please

# ─── Mercado Pago (Fase 3) ──────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_INTEGRATOR_ID=

# ─── Supabase (Fase 5 — Auth + Storage) ─────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret-service-role-jwt>
SUPABASE_ANON_KEY=<sb_publishable_...>

# ─── Resend (Fase 4) ────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Tango QR <no-reply@tangoqr.net>"
ADMIN_NOTIFICATION_EMAIL=admin@tangoqr.net

# ─── Web (apps/web/.env) ────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<sb_publishable_...>
