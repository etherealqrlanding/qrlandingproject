PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# URL pública de esta API (no la del front). En local, distinta de WEB_ORIGIN porque
# corren en servidores separados sin proxy. En producción, si el dominio público
# proxea /api al backend, puede ser igual a WEB_ORIGIN.
API_PUBLIC_URL=http://localhost:4000
# Orígenes extra permitidos por CORS (coma-separados), útil durante una migración de
# dominio: el front se sirve en el dominio nuevo pero WEB_ORIGIN todavía apunta al viejo.
# CORS_EXTRA_ORIGINS=https://dominio-viejo.com,https://www.dominio-viejo.com
# Host público que recibe el webhook de Mercado Pago. En local hace falta un túnel
# (ngrok) porque MP no puede pegarle a localhost; en producción no suele hacer falta
# (cae a WEB_ORIGIN por defecto).
# WEBHOOK_PUBLIC_URL=https://xxxx.ngrok-free.app
DATABASE_URL=postgresql://tangoqr:tangoqr@localhost:5432/tangoqr
COOKIE_SECRET=change-me-in-prod-please

# ─── Email ───────────────────────────────────────────────
# Opción A (recomendada sin dominio): Gmail SMTP. Requiere 2FA + contraseña de aplicación.
# El EMAIL_FROM debe usar el MISMO gmail que SMTP_USER (si no, Gmail lo reescribe).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
EMAIL_FROM=Tango QR <tucuenta@gmail.com>
ADMIN_NOTIFICATION_EMAIL=tucuenta@gmail.com
# Opción B (cuando tengas dominio verificado): Resend
# RESEND_API_KEY=re_...

# Modo test de comunicaciones: si está seteada, TODOS los emails (cliente/vendedor/admin)
# se redirigen acá con el asunto prefijado "[MAIL TESTING]", sin importar el destinatario
# real. Se ignora automáticamente si NODE_ENV=production. Usar solo para revisar contenido,
# ej: TEST_EMAIL_OVERRIDE=xxx npm run send:test-emails
# TEST_EMAIL_OVERRIDE=

# Nautt Finance (PIX en reales)
NAUTT_API_KEY=ntt_xxx
# Opcional: base y uuids traen default de producción (BRL + método PIX)
# NAUTT_BASE_URL=https://api.nauttfinance.com
# NAUTT_CURRENCY_UUID_BRL=73f6eb8b-7066-4f1e-948d-8468966fe766
# NAUTT_PIX_EXCHANGE_UUID=c07441b4-4e23-4fc7-b686-be8967b6e2d9
# Secreto para autenticar el webhook (?token= al registrar la URL en el panel Nautt)
NAUTT_WEBHOOK_TOKEN=cambiame
