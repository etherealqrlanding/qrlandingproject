PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# URL pública de esta API (no la del front). En local, distinta de WEB_ORIGIN porque
# corren en servidores separados sin proxy. En producción, si el dominio público
# proxea /api al backend, puede ser igual a WEB_ORIGIN.
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://ethereal:ethereal@localhost:5432/ethereal_tours
COOKIE_SECRET=change-me-in-prod-please

# ─── Email ───────────────────────────────────────────────
# Opción A (recomendada sin dominio): Gmail SMTP. Requiere 2FA + contraseña de aplicación.
# El EMAIL_FROM debe usar el MISMO gmail que SMTP_USER (si no, Gmail lo reescribe).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
EMAIL_FROM=Tangos y Milongas Tickets <tucuenta@gmail.com>
ADMIN_NOTIFICATION_EMAIL=tucuenta@gmail.com
# Opción B (cuando tengas dominio verificado): Resend
# RESEND_API_KEY=re_...

# Nautt Finance (PIX en reales)
NAUTT_API_KEY=ntt_xxx
# Opcional: base y uuids traen default de producción (BRL + método PIX)
# NAUTT_BASE_URL=https://api.nauttfinance.com
# NAUTT_CURRENCY_UUID_BRL=73f6eb8b-7066-4f1e-948d-8468966fe766
# NAUTT_PIX_EXCHANGE_UUID=c07441b4-4e23-4fc7-b686-be8967b6e2d9
# Secreto para autenticar el webhook (?token= al registrar la URL en el panel Nautt)
NAUTT_WEBHOOK_TOKEN=cambiame
