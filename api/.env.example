SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-de-16-caracteres
EMAIL_FROM=Ethereal Tours <tucuenta@gmail.com>
